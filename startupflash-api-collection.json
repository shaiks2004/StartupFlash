{
  "project": "StartupFlash Headless WordPress API",
  "base_url": "https://thestartupflash.in/wp-json/wp/v2",
  "description": "React frontend connected with existing WordPress backend",
  "apis": {
    "get_all_posts": {
      "method": "GET",
      "endpoint": "/posts?_embed&per_page=10",
      "full_url": "https://thestartupflash.in/wp-json/wp/v2/posts?_embed&per_page=10",
      "purpose": "Homepage latest posts and feed",
      "response_fields": [
        "id",
        "title.rendered",
        "excerpt.rendered",
        "content.rendered",
        "slug",
        "date",
        "_embedded.wp:featuredmedia[0].source_url",
        "_embedded.author[0].name"
      ]
    },

    "get_single_post": {
      "method": "GET",
      "endpoint": "/posts/{id}?_embed",
      "example": "https://thestartupflash.in/wp-json/wp/v2/posts/123?_embed",
      "purpose": "Single article page"
    },

    "get_posts_by_category": {
      "method": "GET",
      "endpoint": "/posts?categories={category_id}&_embed",
      "example": "https://thestartupflash.in/wp-json/wp/v2/posts?categories=5&_embed",
      "purpose": "Funding / AI / Founders sections"
    },

    "get_categories": {
      "method": "GET",
      "endpoint": "/categories",
      "full_url": "https://thestartupflash.in/wp-json/wp/v2/categories",
      "purpose": "Navbar categories and category pages"
    },

    "search_posts": {
      "method": "GET",
      "endpoint": "/posts?search={query}",
      "example": "https://thestartupflash.in/wp-json/wp/v2/posts?search=ai",
      "purpose": "Search functionality"
    },

    "pagination_posts": {
      "method": "GET",
      "endpoint": "/posts?page=2&per_page=10&_embed",
      "example": "https://thestartupflash.in/wp-json/wp/v2/posts?page=2&per_page=10&_embed",
      "purpose": "Load more and infinite scroll"
    },

    "create_post": {
      "method": "POST",
      "endpoint": "/posts",
      "full_url": "https://thestartupflash.in/wp-json/wp/v2/posts",
      "authentication": "Application Password or JWT required",
      "headers": {
        "Authorization": "Basic BASE64_USERNAME_PASSWORD",
        "Content-Type": "application/json"
      },
      "body_example": {
        "title": "Startup raises $50M",
        "content": "<p>Article content here</p>",
        "status": "publish",
        "categories": [5]
      },
      "purpose": "Create new article"
    },

    "update_post": {
      "method": "POST",
      "endpoint": "/posts/{id}",
      "example": "https://thestartupflash.in/wp-json/wp/v2/posts/123",
      "authentication": "Required",
      "body_example": {
        "title": "Updated title",
        "content": "<p>Updated content</p>"
      },
      "purpose": "Update existing article"
    },

    "delete_post": {
      "method": "DELETE",
      "endpoint": "/posts/{id}",
      "example": "https://thestartupflash.in/wp-json/wp/v2/posts/123",
      "authentication": "Required",
      "purpose": "Delete article"
    },

    "upload_media": {
      "method": "POST",
      "endpoint": "/media",
      "full_url": "https://thestartupflash.in/wp-json/wp/v2/media",
      "authentication": "Required",
      "headers": {
        "Content-Disposition": "attachment; filename=image.jpg",
        "Content-Type": "image/jpeg"
      },
      "purpose": "Upload featured images"
    },

    "get_tags": {
      "method": "GET",
      "endpoint": "/tags",
      "full_url": "https://thestartupflash.in/wp-json/wp/v2/tags",
      "purpose": "Trending tags and article tags"
    },

    "get_users": {
      "method": "GET",
      "endpoint": "/users",
      "full_url": "https://thestartupflash.in/wp-json/wp/v2/users",
      "purpose": "Authors and editorial team"
    }
  },

  "frontend_architecture": {
    "framework": "React + Vite",
    "routing": "React Router DOM",
    "styling": "CSS",
    "backend": "WordPress Headless CMS",
    "frontend_goal": "Modern editorial startup news platform UI"
  },

  "recommended_structure": {
    "src/components": [
      "Header.jsx",
      "Ticker.jsx",
      "HeroEditorial.jsx",
      "Spotlight.jsx",
      "TheFeed.jsx",
      "Footer.jsx",
      "ArticleCard.jsx"
    ],

    "src/pages": [
      "Home.jsx",
      "ArticlePage.jsx",
      "CategoryPage.jsx",
      "SearchPage.jsx"
    ],

    "src/services": [
      "api.js"
    ]
  },

  "important_notes": [
    "Always use _embed for featured images and authors",
    "Use pagination for load more functionality",
    "Normalize WordPress response before rendering",
    "Frontend is React only, backend remains WordPress",
    "Do not rebuild CMS or admin dashboard"
  ]
}